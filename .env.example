# Copy to .env.local for local dev, and set the same keys in the Vercel
# project's Environment Variables when deploying.

# WhatsApp number for the CTA links, format: country code + area code + number, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# Canonical site URL, used for sitemap.xml, robots.txt and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://example.com
